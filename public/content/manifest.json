{
  "version": "2.0.0",
  "name": "NSFW RPG Engine Content Pack",
  "description": "Default content pack for the NSFW RPG Engine",
  
  "contentTypes": {
    "scenes": {
      "path": "scenes/",
      "files": [
        "intro_scenes.json"
      ]
    },
    "items": {
      "path": "items/",
      "files": [
        "weapons_armor.json",
        "clothing_paperdoll.json"
      ]
    },
    "enemies": {
      "path": "enemies/",
